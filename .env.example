# Claude Code 环境变量配置

# ===== Ollama 模型配置 =====
OLLAMA_MODEL=gemma3:1b

# ===== Ollama API 配置（可选） =====
# 配置后将使用 HTTP API 替代本地 CLI 调用，支持远程 Ollama 或 OpenAI 兼容接口
#
# 方式一：远程 Ollama 实例
# OLLAMA_BASE_URL=http://your-server:11434
# OLLAMA_API_KEY=your-api-key
#
# 方式二：OpenAI 兼容接口（如 vLLM、LiteLLM、OpenRouter 等）
# OLLAMA_BASE_URL=https://api.openrouter.ai/v1
# OLLAMA_API_KEY=your-api-key
# OLLAMA_MODEL=google/gemma-3-1b
#
# 不配置 OLLAMA_BASE_URL 则默认使用本地 ollama CLI（无需改动）
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# ===== TTS(文本转语音)配置 =====
# TTS 提供商:pyttsx3(本地，无需 API)、openai、elevenlabs
# 默认:pyttsx3(推荐，无需配置)
HOOKS_TTS_PROVIDER=pyttsx3

# 是否启用 TTS 语音播报:true 或 false
# 默认:true
HOOKS_TTS_ENABLED=true