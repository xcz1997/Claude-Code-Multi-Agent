{
  "mcpServers": {
    "Exa AI (搜索)": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=42c821b4-253d-4fa0-818d-55b127dfa704",
      "headers": {}
    },
    "mcp-feedback-enhanced": {
      "command": "uvx",
      "args": [
        "mcp-feedback-enhanced@latest"
      ],
      "timeout": 600,
      "env": {
        "MCP_DESKTOP_MODE": "true",
        "MCP_WEB_HOST": "127.0.0.1",
        "MCP_WEB_PORT": "8765",
        "MCP_DEBUG": "false"
      },
      "autoApprove": [
        "interactive_feedback"
      ]
    },
    "Shrimp Task Manager": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-shrimp-task-manager"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Volumes/Extra/src"
      ]
    },
    "magic": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "API_KEY": ""
      }
    },
    "magic-ui": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "magicui-mcp"
      ],
      "env": {}
    },
    "time-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "time-mcp"
      ],
      "env": {}
    }
  }
}